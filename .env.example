# Copy to .env and fill in. Never commit .env.
# Generate each secret with:  openssl rand -hex 32

# --- Granite 4.2 30B: the main model, already running on its own vLLM server ---
# Base address of that server, without /v1. Use https:// unless it runs on this same machine
# (then http://host.docker.internal:8000).
GRANITE_URL=
# The server's --api-key, if it has one. Only granite-gateway holds it.
GRANITE_API_KEY=
# CA certificate for the server's https certificate, if it comes from a private CA.
# Put it in gateway/ and set:  GRANITE_CA_PATH=/etc/nginx/granite/granite-ca.pem
# The server's --served-model-name.
GRANITE_MODEL=granite-4.2-30b

# --- Secrets ---
POSTGRES_PASSWORD=
POLICY_API_KEY=
LINK_SIGNING_KEY=
LLM_API_KEY=
OPENWEBUI_SECRET_KEY=
# Open WebUI's key for Hermes. At least 16 characters.
HERMES_API_KEY=

# --- Image tags: pin exact versions you have tested. Never use "latest". ---
# vLLM: Granite 4.2 needs 0.20 or later, Inkling 0.26.0 or later. TEI: use the tag for your GPU family (see TEI's README, e.g. hopper-*).
VLLM_TAG=
TEI_TAG=
OPENWEBUI_TAG=
# Hermes Agent image tag (built from commit 86fa9e6 or later). Pin by digest once tested.
HERMES_TAG=
# How long the assistant waits on a running check before saying "still running, ask again".
# Keep SECRETARY_MAX_WAIT_MINUTES * 60 below OPENWEBUI_TIMEOUT_SECONDS.
SECRETARY_MAX_WAIT_MINUTES=10
OPENWEBUI_TIMEOUT_SECONDS=900
PGVECTOR_TAG=pg17
APP_VERSION=0.1.0

# --- GPUs: filled in by scripts/setup_gpus.py (or by hand, see compose.gpu.example.yaml) ---
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
ESCALATE_TP=1
# Folder name under MODELS_DIR for Inkling-Small. Confirm the exact name on its model card.
ESCALATE_MODEL_DIR=inkling-small

# --- Where things are ---
MODELS_DIR=./models
POLICY_SOURCE_DIR=./samples/policies
# The address people's browsers use to reach policy-api (for Excel download links), and the hostnames it accepts.
PUBLIC_BASE_URL=http://localhost:8100
ALLOWED_HOSTS=localhost,127.0.0.1,policy-api
# Interface the two web ports listen on. Keep 127.0.0.1 and put your reverse proxy in front.
BIND_ADDR=127.0.0.1

# --- Optional models (leave empty to turn off) ---
# ESCALATE_URL=http://escalate:8000/v1
ESCALATE_URL=
# EXTRACT_URL=http://extract:8000/v1
EXTRACT_URL=

# --- Tuning ---
JUDGE_CONCURRENCY=16
# 1 = the judge reasons before answering (Granite 4.2 thinking mode). Slower; try it on eval/ cases first.
JUDGE_THINKING=0
SEMANTIC_K=30
RERANK_KEEP=20
# Regex for policy IDs as they are written in your documents (POL-007, SAF-112, ...).
POLICY_ID_PATTERN=[A-Z]{2,6}-\d{1,5}

# 1 = stand-in models and sample policies, no GPUs. For trying the flow only.
DEMO_MODE=0
# true only while you create the first admin account, then back to false
OPENWEBUI_ENABLE_SIGNUP=false

# --- Job queue (docs/operations.md#the-job-queue) ---
WORKER_ENABLED=1
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
# Generated reports and documents are deleted after this many days (a check's report can be rebuilt).
EXPORT_RETENTION_DAYS=30

# --- Review queue (Argilla) ---
# Start it with:  docker compose --profile review up -d     (docs/review-and-training.md)
# Image tags: pinned and tested together. Change them only after testing the new set.
ARGILLA_TAG=v2.8.0
ARGILLA_ES_TAG=8.17.0
ARGILLA_REDIS_TAG=7.4.2-alpine
ARGILLA_PG_TAG=16.6-alpine
# Secrets. Use letters and digits only (openssl rand -hex 16). The password must be 8+ characters.
ARGILLA_DB_PASSWORD=
ARGILLA_ADMIN_USER=admin
ARGILLA_ADMIN_PASSWORD=
ARGILLA_API_KEY=
ARGILLA_WORKSPACE=policy-review
# Turn on sending verdicts to reviewers (leave empty until the review stack is running):
ARGILLA_URL=
# Every yes and "maybe" goes to reviewers; this share of "no" answers does too, to catch misses.
REVIEW_SAMPLE_NO=0.1
# Memory for the review search index. Raise to 2g if you review tens of thousands of cards.
ARGILLA_ES_HEAP=1g

# --- Training ---
# Needs a GPU assigned in compose.gpu.yaml (docs/review-and-training.md). Outputs land here, outside git.
TRAIN_OUT_DIR=./training/out
# GPUs for the judge-candidate service (the model being tested before it replaces the judge).
CANDIDATE_TP=1
# After a tuned judge passes the evaluation (docs/review-and-training.md):
# TUNED_JUDGE_DIR=judge-tuned-2026-11
# TUNED_TP=1
# JUDGE_URL=http://judge-tuned:8000/v1
# JUDGE_MODEL=judge-tuned
